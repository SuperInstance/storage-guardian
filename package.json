{
  "name": "@superinstance/storage-guardian",
  "version": "0.2.0",
  "description": "Storage Guardian — duplicate detection, deduplication, storage budget enforcement, trend analysis, and alerting for JS/TS projects",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "storage-guardian": "dist/cli.js"
  },
  "files": ["dist", "CHANGELOG.md", "CONTRIBUTING.md"],
  "scripts": {
    "build": "tsc",
    "test": "jest --config jest.config.js",
    "test:coverage": "jest --config jest.config.js --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "cli": "ts-node src/cli.ts"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    }
  },
  "keywords": ["storage", "duplicate", "deduplication", "budget", "guardian", "content-addressable", "hash", "s3", "cloud-storage", "alerting", "trend-analysis"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SuperInstance/storage-guardian"
  },
  "homepage": "https://github.com/SuperInstance/storage-guardian#readme",
  "bugs": {
    "url": "https://github.com/SuperInstance/storage-guardian/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
